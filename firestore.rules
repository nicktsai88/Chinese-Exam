rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Family nickname mode: authenticated visitors share the name directory and profiles.
    // Anonymous authentication is automatic; a name is a selector, not a security credential.
    match /artifacts/forest-app-default/Chinese5-exam1/{profileId} {
      function familyVisitor() { return request.auth != null; }
      function valid() {
        let d = request.resource.data;
        return profileId.matches('name_[0-9a-f]+')
          && d.keys().hasOnly(['mode','displayName','schema','dataVersion','revision','payload','updatedAt'])
          && d.mode == 'familyName' && d.displayName is string
          && d.displayName.size() > 0 && d.displayName.size() <= 30
          && d.schema == 1 && d.dataVersion == '2026-10-08-v1'
          && d.revision is int && d.revision > 0
          && d.updatedAt == request.time
          && d.payload is map && d.payload.version == 1
          && d.payload.users is list && d.payload.users.size() == 1
          && d.payload.current == d.displayName
          && d.payload.users[0].name == d.displayName;
      }
      allow get: if familyVisitor() && profileId.matches('name_[0-9a-f]+');
      allow list: if familyVisitor() && resource.data.mode == 'familyName';
      allow create: if familyVisitor() && valid() && request.resource.data.revision == 1;
      allow update: if familyVisitor() && resource.data.mode == 'familyName' && valid()
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
